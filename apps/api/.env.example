# Server-only local configuration. Do not put the key in VITE_* or frontend code.
LLM_BASE_URL=https://api.openai-next.com/v1
LLM_MODEL=kimi-k2.5
LLM_API_KEY=
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=1
LLM_MAX_TOKENS=8192
LLM_JSON_MODE=true
# Leave empty for relay defaults. Set disabled only if your relay supports Kimi thinking controls.
LLM_THINKING=
